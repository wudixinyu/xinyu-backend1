<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.YgAiPromptMapper">
    
    <resultMap type="YgAiPrompt" id="YgAiPromptResult">
        <result property="promptId"       column="prompt_id"       />
        <result property="promptName"     column="prompt_name"     />
        <result property="promptType"     column="prompt_type"     />
        <result property="promptContent"  column="prompt_content"  />
        <result property="modelName"      column="model_name"      />
        <result property="status"         column="status"          />
        <result property="delFlag"        column="del_flag"        />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>

    <sql id="selectYgAiPromptVo">
        select prompt_id, prompt_name, prompt_type, prompt_content, model_name, status, del_flag,
        create_by, create_time, update_by, update_time, remark from yg_ai_prompt
    </sql>

    <select id="selectYgAiPromptList" parameterType="YgAiPrompt" resultMap="YgAiPromptResult">
        <include refid="selectYgAiPromptVo"/>
        <where>  
            del_flag = '0'
            <if test="promptName != null  and promptName != ''"> and prompt_name like concat('%', #{promptName}, '%')</if>
            <if test="promptType != null "> and prompt_type = #{promptType}</if>
            <if test="modelName != null  and modelName != ''"> and model_name like concat('%', #{modelName}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by prompt_id desc
    </select>
    
    <select id="selectYgAiPromptByPromptId" parameterType="Long" resultMap="YgAiPromptResult">
        <include refid="selectYgAiPromptVo"/>
        where prompt_id = #{promptId} and del_flag = '0'
    </select>

    <insert id="insertYgAiPrompt" parameterType="YgAiPrompt" useGeneratedKeys="true" keyProperty="promptId">
        insert into yg_ai_prompt
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="promptName != null and promptName != ''">prompt_name,</if>
            <if test="promptType != null">prompt_type,</if>
            <if test="promptContent != null and promptContent != ''">prompt_content,</if>
            <if test="modelName != null">model_name,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="promptName != null and promptName != ''">#{promptName},</if>
            <if test="promptType != null">#{promptType},</if>
            <if test="promptContent != null and promptContent != ''">#{promptContent},</if>
            <if test="modelName != null">#{modelName},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateYgAiPrompt" parameterType="YgAiPrompt">
        update yg_ai_prompt
        <trim prefix="SET" suffixOverrides=",">
            <if test="promptName != null and promptName != ''">prompt_name = #{promptName},</if>
            <if test="promptType != null">prompt_type = #{promptType},</if>
            <if test="promptContent != null and promptContent != ''">prompt_content = #{promptContent},</if>
            <if test="modelName != null">model_name = #{modelName},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where prompt_id = #{promptId}
    </update>

    <delete id="deleteYgAiPromptByPromptId" parameterType="Long">
        delete from yg_ai_prompt where prompt_id = #{promptId}
    </delete>

    <delete id="deleteYgAiPromptByPromptIds" parameterType="String">
        delete from yg_ai_prompt where prompt_id in 
        <foreach item="promptId" collection="array" open="(" separator="," close=")">
            #{promptId}
        </foreach>
    </delete>
</mapper>
