<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.YgKnowledgeBaseMapper">

    <resultMap type="YgKnowledgeBase" id="YgKnowledgeBaseResult">
        <result property="kbId"           column="kb_id"           />
        <result property="kbName"         column="kb_name"         />
        <result property="description"    column="description"     />
        <result property="embeddingModel" column="embedding_model" />
        <result property="embeddingDim"   column="embedding_dim"   />
        <result property="docCount"       column="doc_count"       />
        <result property="chunkCount"     column="chunk_count"     />
        <result property="status"         column="status"          />
        <result property="delFlag"        column="del_flag"        />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>

    <sql id="selectYgKnowledgeBaseVo">
        select kb_id, kb_name, description, embedding_model, embedding_dim, doc_count, chunk_count,
        status, del_flag, create_by, create_time, update_by, update_time, remark from yg_knowledge_base
    </sql>

    <select id="selectYgKnowledgeBaseList" parameterType="YgKnowledgeBase" resultMap="YgKnowledgeBaseResult">
        <include refid="selectYgKnowledgeBaseVo"/>
        <where>
            del_flag = '0'
            <if test="kbName != null and kbName != ''"> and kb_name like concat('%', #{kbName}, '%')</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by kb_id desc
    </select>

    <select id="selectYgKnowledgeBaseByKbId" parameterType="Long" resultMap="YgKnowledgeBaseResult">
        <include refid="selectYgKnowledgeBaseVo"/>
        where kb_id = #{kbId} and del_flag = '0'
    </select>

    <insert id="insertYgKnowledgeBase" parameterType="YgKnowledgeBase" useGeneratedKeys="true" keyProperty="kbId">
        insert into yg_knowledge_base
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="kbName != null and kbName != ''">kb_name,</if>
            <if test="description != null">description,</if>
            <if test="embeddingModel != null">embedding_model,</if>
            <if test="embeddingDim != null">embedding_dim,</if>
            <if test="docCount != null">doc_count,</if>
            <if test="chunkCount != null">chunk_count,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="kbName != null and kbName != ''">#{kbName},</if>
            <if test="description != null">#{description},</if>
            <if test="embeddingModel != null">#{embeddingModel},</if>
            <if test="embeddingDim != null">#{embeddingDim},</if>
            <if test="docCount != null">#{docCount},</if>
            <if test="chunkCount != null">#{chunkCount},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateYgKnowledgeBase" parameterType="YgKnowledgeBase">
        update yg_knowledge_base
        <trim prefix="SET" suffixOverrides=",">
            <if test="kbName != null and kbName != ''">kb_name = #{kbName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="docCount != null">doc_count = #{docCount},</if>
            <if test="chunkCount != null">chunk_count = #{chunkCount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where kb_id = #{kbId}
    </update>

    <update id="deleteYgKnowledgeBaseByKbIds" parameterType="String">
        update yg_knowledge_base set del_flag = '2' where kb_id in
        <foreach item="kbId" collection="array" open="(" separator="," close=")">
            #{kbId}
        </foreach>
    </update>

    <update id="updateStats" parameterType="Long">
        update yg_knowledge_base b
        set b.doc_count = (select count(*) from yg_kb_document d where d.kb_id = b.kb_id and d.del_flag = '0'),
            b.chunk_count = (select ifnull(sum(d.chunk_count), 0) from yg_kb_document d where d.kb_id = b.kb_id and d.del_flag = '0')
        where b.kb_id = #{kbId}
    </update>
</mapper>
