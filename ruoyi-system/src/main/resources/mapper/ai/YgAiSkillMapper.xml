<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.YgAiSkillMapper">
    
    <resultMap type="YgAiSkill" id="YgAiSkillResult">
        <result property="skillId"       column="skill_id"       />
        <result property="skillName"     column="skill_name"     />
        <result property="skillCode"     column="skill_code"     />
        <result property="category"      column="category"       />
        <result property="description"   column="description"    />
        <result property="content"       column="content"        />
        <result property="status"        column="status"         />
        <result property="delFlag"       column="del_flag"       />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <!-- 列表查询不取 content 大字段，避免分页加载全部技能内容 -->
    <sql id="selectYgAiSkillListVo">
        select skill_id, skill_name, skill_code, category, description, status, del_flag,
        create_by, create_time, update_by, update_time, remark from yg_ai_skill
    </sql>

    <sql id="selectYgAiSkillFullVo">
        select skill_id, skill_name, skill_code, category, description, content, status, del_flag,
        create_by, create_time, update_by, update_time, remark from yg_ai_skill
    </sql>

    <select id="selectYgAiSkillList" parameterType="YgAiSkill" resultMap="YgAiSkillResult">
        <include refid="selectYgAiSkillListVo"/>
        <where>  
            del_flag = '0'
            <if test="skillName != null  and skillName != ''"> and skill_name like concat('%', #{skillName}, '%')</if>
            <if test="skillCode != null  and skillCode != ''"> and skill_code like concat('%', #{skillCode}, '%')</if>
            <if test="category != null  and category != ''"> and category = #{category}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by skill_id desc
    </select>
    
    <select id="selectYgAiSkillBySkillId" parameterType="Long" resultMap="YgAiSkillResult">
        <include refid="selectYgAiSkillFullVo"/>
        where skill_id = #{skillId} and del_flag = '0'
    </select>

    <select id="selectYgAiSkillBySkillCode" parameterType="String" resultMap="YgAiSkillResult">
        <include refid="selectYgAiSkillListVo"/>
        where skill_code = #{skillCode} and del_flag = '0' limit 1
    </select>

    <insert id="insertYgAiSkill" parameterType="YgAiSkill" useGeneratedKeys="true" keyProperty="skillId">
        insert into yg_ai_skill
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="skillName != null and skillName != ''">skill_name,</if>
            <if test="skillCode != null and skillCode != ''">skill_code,</if>
            <if test="category != null">category,</if>
            <if test="description != null">description,</if>
            <if test="content != null">content,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="skillName != null and skillName != ''">#{skillName},</if>
            <if test="skillCode != null and skillCode != ''">#{skillCode},</if>
            <if test="category != null">#{category},</if>
            <if test="description != null">#{description},</if>
            <if test="content != null">#{content},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateYgAiSkill" parameterType="YgAiSkill">
        update yg_ai_skill
        <trim prefix="SET" suffixOverrides=",">
            <if test="skillName != null and skillName != ''">skill_name = #{skillName},</if>
            <if test="skillCode != null and skillCode != ''">skill_code = #{skillCode},</if>
            <if test="category != null">category = #{category},</if>
            <if test="description != null">description = #{description},</if>
            <if test="content != null">content = #{content},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where skill_id = #{skillId}
    </update>

    <delete id="deleteYgAiSkillBySkillId" parameterType="Long">
        delete from yg_ai_skill where skill_id = #{skillId}
    </delete>

    <delete id="deleteYgAiSkillBySkillIds" parameterType="String">
        delete from yg_ai_skill where skill_id in 
        <foreach item="skillId" collection="array" open="(" separator="," close=")">
            #{skillId}
        </foreach>
    </delete>
</mapper>
