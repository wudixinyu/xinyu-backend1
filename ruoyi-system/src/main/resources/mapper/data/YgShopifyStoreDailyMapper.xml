<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.YgShopifyStoreDailyMapper">

    <resultMap type="YgShopifyStoreDaily" id="YgShopifyStoreDailyResult">
        <result property="dailyId"     column="daily_id"      />
        <result property="reportDate"  column="report_date"   />
        <result property="storeDomain" column="store_domain"  />
        <result property="channel"     column="channel"       />
        <result property="sessions"    column="sessions"      />
        <result property="orders"      column="orders"        />
        <result property="unitsSold"   column="units_sold"    />
        <result property="revenue"     column="revenue"       />
        <result property="createBy"    column="create_by"     />
        <result property="createTime"  column="create_time"   />
        <result property="updateBy"    column="update_by"     />
        <result property="updateTime"  column="update_time"   />
        <result property="remark"      column="remark"        />
    </resultMap>

    <sql id="selectYgShopifyStoreDailyVo">
        select daily_id, report_date, store_domain, channel, sessions, orders, units_sold, revenue,
        create_by, create_time, update_by, update_time, remark from yg_shopify_store_daily
    </sql>

    <select id="selectYgShopifyStoreDailyList" parameterType="YgShopifyStoreDaily" resultMap="YgShopifyStoreDailyResult">
        <include refid="selectYgShopifyStoreDailyVo"/>
        <where>
            <if test="channel != null and channel != ''"> and channel like concat('%', #{channel}, '%')</if>
            <if test="storeDomain != null and storeDomain != ''"> and store_domain = #{storeDomain}</if>
            <if test="params.beginTime != null and params.beginTime != ''"> and report_date &gt;= #{params.beginTime}</if>
            <if test="params.endTime != null and params.endTime != ''"> and report_date &lt;= #{params.endTime}</if>
        </where>
        order by report_date desc, daily_id desc
    </select>

    <select id="selectYgShopifyStoreDailyByDailyId" parameterType="Long" resultMap="YgShopifyStoreDailyResult">
        <include refid="selectYgShopifyStoreDailyVo"/>
        where daily_id = #{dailyId}
    </select>

    <select id="selectByUniqueKey" resultMap="YgShopifyStoreDailyResult">
        <include refid="selectYgShopifyStoreDailyVo"/>
        where report_date = date(#{reportDate}) and store_domain = #{storeDomain} and channel = #{channel}
        limit 1
    </select>

    <insert id="insertYgShopifyStoreDaily" parameterType="YgShopifyStoreDaily" useGeneratedKeys="true" keyProperty="dailyId">
        insert into yg_shopify_store_daily
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="reportDate != null">report_date,</if>
            <if test="storeDomain != null">store_domain,</if>
            <if test="channel != null and channel != ''">channel,</if>
            <if test="sessions != null">sessions,</if>
            <if test="orders != null">orders,</if>
            <if test="unitsSold != null">units_sold,</if>
            <if test="revenue != null">revenue,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="reportDate != null">#{reportDate},</if>
            <if test="storeDomain != null">#{storeDomain},</if>
            <if test="channel != null and channel != ''">#{channel},</if>
            <if test="sessions != null">#{sessions},</if>
            <if test="orders != null">#{orders},</if>
            <if test="unitsSold != null">#{unitsSold},</if>
            <if test="revenue != null">#{revenue},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateYgShopifyStoreDaily" parameterType="YgShopifyStoreDaily">
        update yg_shopify_store_daily
        <trim prefix="SET" suffixOverrides=",">
            <if test="reportDate != null">report_date = #{reportDate},</if>
            <if test="storeDomain != null">store_domain = #{storeDomain},</if>
            <if test="channel != null and channel != ''">channel = #{channel},</if>
            <if test="sessions != null">sessions = #{sessions},</if>
            <if test="orders != null">orders = #{orders},</if>
            <if test="unitsSold != null">units_sold = #{unitsSold},</if>
            <if test="revenue != null">revenue = #{revenue},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where daily_id = #{dailyId}
    </update>

    <delete id="deleteYgShopifyStoreDailyByDailyIds" parameterType="String">
        delete from yg_shopify_store_daily where daily_id in
        <foreach item="dailyId" collection="array" open="(" separator="," close=")">
            #{dailyId}
        </foreach>
    </delete>

    <!-- 统计公共查询条件 -->
    <sql id="statsWhere">
        <where>
            <if test="channel != null and channel != ''"> and channel like concat('%', #{channel}, '%')</if>
            <if test="storeDomain != null and storeDomain != ''"> and store_domain = #{storeDomain}</if>
            <if test="params.beginTime != null and params.beginTime != ''"> and report_date &gt;= #{params.beginTime}</if>
            <if test="params.endTime != null and params.endTime != ''"> and report_date &lt;= #{params.endTime}</if>
        </where>
    </sql>

    <select id="selectStoreSummary" parameterType="YgShopifyStoreDaily" resultType="map">
        select ifnull(sum(sessions), 0)    sessions,
               ifnull(sum(orders), 0)      orders,
               ifnull(sum(units_sold), 0)  units_sold,
               ifnull(sum(revenue), 0)     revenue,
               round(sum(orders) / nullif(sum(sessions), 0) * 100, 2) cvr,
               round(sum(revenue) / nullif(sum(orders), 0), 2) aov
        from yg_shopify_store_daily
        <include refid="statsWhere"/>
    </select>

    <select id="selectStoreTrend" parameterType="YgShopifyStoreDaily" resultType="map">
        select date_format(report_date, '%Y-%m-%d') statDate,
               ifnull(sum(sessions), 0)    sessions,
               ifnull(sum(orders), 0)      orders,
               ifnull(sum(units_sold), 0)  units_sold,
               ifnull(sum(revenue), 0)     revenue,
               round(sum(orders) / nullif(sum(sessions), 0) * 100, 2) cvr,
               round(sum(revenue) / nullif(sum(orders), 0), 2) aov
        from yg_shopify_store_daily
        <include refid="statsWhere"/>
        group by report_date
        order by report_date
    </select>

    <select id="selectStoreChannelStats" parameterType="YgShopifyStoreDaily" resultType="map">
        select channel,
               ifnull(sum(sessions), 0)    sessions,
               ifnull(sum(orders), 0)      orders,
               ifnull(sum(units_sold), 0)  units_sold,
               ifnull(sum(revenue), 0)     revenue,
               round(sum(orders) / nullif(sum(sessions), 0) * 100, 2) cvr,
               round(sum(revenue) / nullif(sum(orders), 0), 2) aov
        from yg_shopify_store_daily
        <include refid="statsWhere"/>
        group by channel
        order by sum(revenue) desc
        limit 20
    </select>
</mapper>
