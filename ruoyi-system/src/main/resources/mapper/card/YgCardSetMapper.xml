<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.YgCardSetMapper">
    
    <resultMap type="YgCardSet" id="YgCardSetResult">
        <id     property="setId"        column="set_id"         />
        <result property="setCode"      column="set_code"       />
        <result property="setValue"     column="set_value"      />
        <result property="cnName"       column="cn_name"        />
        <result property="jpName"       column="jp_name"        />
        <result property="enName"       column="en_name"        />
        <result property="status"       column="status"         />
        <result property="createBy"     column="create_by"      />
        <result property="createTime"   column="create_time"    />
        <result property="updateBy"     column="update_by"      />
        <result property="updateTime"   column="update_time"    />
        <result property="remark"       column="remark"         />
    </resultMap>

    <sql id="selectYgCardSetVo">
        select set_id, set_code, set_value, cn_name, jp_name, en_name, status, create_by, create_time, update_by, update_time, remark from yg_card_set
    </sql>

    <select id="selectYgCardSetList" parameterType="YgCardSet" resultMap="YgCardSetResult">
        <include refid="selectYgCardSetVo"/>
        <where>  
            <if test="setCode != null  and setCode != ''"> and set_code = #{setCode}</if>
            <if test="setValue != null "> and set_value = #{setValue}</if>
            <if test="cnName != null  and cnName != ''"> and cn_name like concat('%', #{cnName}, '%')</if>
            <if test="jpName != null  and jpName != ''"> and jp_name like concat('%', #{jpName}, '%')</if>
            <if test="enName != null  and enName != ''"> and en_name like concat('%', #{enName}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectYgCardSetBySetId" parameterType="Long" resultMap="YgCardSetResult">
        <include refid="selectYgCardSetVo"/>
        where set_id = #{setId}
    </select>

    <insert id="insertYgCardSet" parameterType="YgCardSet" useGeneratedKeys="true" keyProperty="setId">
        insert into yg_card_set
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="setCode != null and setCode != ''">set_code,</if>
            <if test="setValue != null">set_value,</if>
            <if test="cnName != null">cn_name,</if>
            <if test="jpName != null">jp_name,</if>
            <if test="enName != null">en_name,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="setCode != null and setCode != ''">#{setCode},</if>
            <if test="setValue != null">#{setValue},</if>
            <if test="cnName != null">#{cnName},</if>
            <if test="jpName != null">#{jpName},</if>
            <if test="enName != null">#{enName},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateYgCardSet" parameterType="YgCardSet">
        update yg_card_set
        <trim prefix="SET" suffixOverrides=",">
            <if test="setCode != null and setCode != ''">set_code = #{setCode},</if>
            <if test="setValue != null">set_value = #{setValue},</if>
            <if test="cnName != null">cn_name = #{cnName},</if>
            <if test="jpName != null">jp_name = #{jpName},</if>
            <if test="enName != null">en_name = #{enName},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where set_id = #{setId}
    </update>

    <delete id="deleteYgCardSetBySetId" parameterType="Long">
        delete from yg_card_set where set_id = #{setId}
    </delete>

    <delete id="deleteYgCardSetBySetIds" parameterType="String">
        delete from yg_card_set where set_id in 
        <foreach item="setId" collection="array" open="(" separator="," close=")">
            #{setId}
        </foreach>
    </delete>

    <insert id="batchUpsertYgCardSet" parameterType="java.util.List">
        insert into yg_card_set (set_code, set_value, cn_name, jp_name, en_name, create_time, update_time) values
        <foreach item="item" collection="list" separator=",">
            (#{item.setCode}, #{item.setValue}, #{item.cnName}, #{item.jpName}, #{item.enName}, sysdate(), sysdate())
        </foreach>
        on duplicate key update update_time = sysdate()
    </insert>
</mapper>
